# infra/.env.deploy — operator-local deploy configuration
# Copy this file to infra/.env.deploy and fill in your values.
# infra/.env.deploy is gitignored and must never be committed.

# The URL Cloud Run redirects to after Google OAuth completes.
GOOGLE_REDIRECT_URI=https://your-domain.example.com/auth/callback

# Comma-separated list of origins allowed by the backend CORS policy.
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# Comma-separated, case-insensitive owner-email allowlist (HEL-703). A matching email is assigned
# `owner` tier at signup and promoted to `owner` at login, on both auth paths. Prod value:
# mattheworr018@gmail.com.
HELIO_OWNER_EMAILS=mattheworr018@gmail.com

# Optional: max beta-tier chat messages per UTC day (HEL-703). Uncomment to override the
# UserTierConfig default (50) without a redeploy of the image itself.
# HELIO_BETA_DAILY_MESSAGE_LIMIT=50

# NOTE: COOKIE_SECURE is NOT set here and is not operator-supplied. deploy-backend.sh hardcodes
# COOKIE_SECURE=true directly in its --set-env-vars list, since this deploy target is always the
# cross-site prod topology (Firebase Hosting frontend / Cloud Run backend) where the session
# cookie requires Secure + SameSite=None to function at all (see CLAUDE.md's "Production
# environment variables" table and docs/deployment.md).

# NOTE: ANTHROPIC_API_KEY is NOT set here and is not operator-supplied via this file. It is a
# secret (like DB_PASSWORD/GOOGLE_CLIENT_SECRET) sourced from Secret Manager via
# deploy-backend.sh's --set-secrets list (secret name: helio-anthropic-api-key). Provisioning
# that secret's value in Secret Manager is a one-time infra-operator action outside this repo
# (HEL-390 / CLAUDE.md's "Production environment variables" table).
