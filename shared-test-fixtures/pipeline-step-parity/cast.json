          { "v": "1.7E9" },
          { "v": null },
          { "v": "99999999999999" }
        ]
      }
    },
    {
      "name": "a field the row does not have is added as null",
      "config": { "casts": { "gone": "string" } },
      "inputRows": [{ "a": 1.0 }],
      "expect": { "rows": [{ "a": 1.0, "gone": null }] }
    },
    {
      "name": "an unsupported target passes the value through unchanged",
      "config": { "casts": { "v": "weird" } },
      "inputRows": [{ "v": 1.0 }, { "v": "x" }, { "v": null }],
      "expect": { "rows": [{ "v": 1.0 }, { "v": "x" }, { "v": null }] }
    },
    {
      "name": "several casts at once",
