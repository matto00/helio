{
  "kind": "cast",
  "vectors": [
    {
      "name": "integer: Java Integer.parseInt first, then the double fallback",
      "config": { "casts": { "v": "integer" } },
      "inputRows": [
        { "v": "1d" },
        { "v": "1f" },
        { "v": " 1 " },
        { "v": " 1" },
        { "v": "0x1p3" },
        { "v": "0x10" },
        { "v": "NaN" },
        { "v": "Infinity" },
        { "v": "+1" },
        { "v": "1_000" },
        { "v": "1e400" },
        { "v": "-0" },
        { "v": "" },
        { "v": "abc" },
        { "v": "1.9" },
        { "v": "2147483648" },
        { "v": "-2147483649" },
        { "v": "1e3" },
        { "v": "\u0663" },
        { "v": "\u2460" }
      ],
      "expect": {
        "rows": [
          { "v": { "$int": 1 } },
          { "v": { "$int": 1 } },
          { "v": { "$int": 1 } },
          { "v": { "$int": 1 } },
          { "v": { "$int": 8 } },
          { "v": null },
          { "v": { "$int": 0 } },
          { "v": { "$int": 2147483647 } },
          { "v": { "$int": 1 } },
          { "v": null },
          { "v": { "$int": 2147483647 } },
          { "v": { "$int": 0 } },
          { "v": null },
          { "v": null },
          { "v": { "$int": 1 } },
          { "v": { "$int": 2147483647 } },
          { "v": { "$int": -2147483648 } },
          { "v": { "$int": 1000 } },
          { "v": { "$int": 3 } },
          { "v": null }
        ]
      }
    },
    {
      "name": "integer from numbers, booleans and null",
      "config": { "casts": { "v": "integer" } },
      "inputRows": [
        { "v": 3.7 },
        { "v": -3.7 },
        { "v": { "$int": 5 } },
        { "v": { "$long": "9" } },
        { "v": true },
        { "v": null },
        { "v": { "$double": "NaN" } },
        { "v": { "$double": "Infinity" } },
        { "v": { "$double": "-Infinity" } },
        { "v": 10000000000.0 }
      ],
      "expect": {
        "rows": [
          { "v": { "$int": 3 } },
          { "v": { "$int": -3 } },
          { "v": { "$int": 5 } },
          { "v": { "$int": 9 } },
          { "v": null },
          { "v": null },
          { "v": { "$int": 0 } },
          { "v": { "$int": 2147483647 } },
          { "v": { "$int": -2147483648 } },
          { "v": { "$int": 2147483647 } }
        ]
      }
    },
    {
      "name": "integer parses Unicode decimal digits like Character.digit",
      "config": { "casts": { "v": "integer" } },
      "inputRows": [{ "v": "\u0663" }, { "v": "\uff11\uff12" }, { "v": "1\u0662" }],
      "expect": {
        "rows": [{ "v": { "$int": 3 } }, { "v": { "$int": 12 } }, { "v": { "$int": 12 } }]
      }
    },
    {
      "name": "long: Java Long.parseLong first, then the double fallback",
      "config": { "casts": { "v": "long" } },
      "inputRows": [
        { "v": "12" },
        { "v": "-12" },
        { "v": "+5" },
        { "v": "2147483648" },
        { "v": "9007199254740991" },
        { "v": "1.9" },
        { "v": " 7 " },
        { "v": "1d" },
        { "v": "NaN" },
        { "v": "abc" },
        { "v": "0x10" },
        { "v": "1e3" },
        { "v": "" }
      ],
      "expect": {
        "rows": [
          { "v": { "$long": "12" } },
          { "v": { "$long": "-12" } },
          { "v": { "$long": "5" } },
          { "v": { "$long": "2147483648" } },
          { "v": { "$long": "9007199254740991" } },
          { "v": { "$long": "1" } },
          { "v": { "$long": "7" } },
          { "v": { "$long": "1" } },
          { "v": { "$long": "0" } },
          { "v": null },
          { "v": null },
          { "v": { "$long": "1000" } },
          { "v": null }
        ]
      }
    },
    {
      "name": "long from numbers and null",
      "config": { "casts": { "v": "long" } },
      "inputRows": [
        { "v": 2147483648.0 },
        { "v": -2.5 },
        { "v": { "$int": 7 } },
        { "v": null },
        { "v": { "$double": "NaN" } }
      ],
      "expect": {
        "rows": [
          { "v": { "$long": "2147483648" } },
          { "v": { "$long": "-2" } },
          { "v": { "$long": "7" } },
          { "v": null },
          { "v": { "$long": "0" } }
        ]
      }
    },
    {
      "name": "double, float and number parse the Java way and yield Doubles",
      "config": { "casts": { "a": "double", "b": "float", "c": "number" } },
      "inputRows": [
        { "a": "1d", "b": "1d", "c": "1d" },
        { "a": "1f", "b": "1f", "c": "1f" },
        { "a": " 1 ", "b": " 1 ", "c": " 1 " },
        { "a": " 1", "b": " 1", "c": " 1" },
        { "a": "0x1p3", "b": "0x1p3", "c": "0x1p3" },
        { "a": "0x10", "b": "0x10", "c": "0x10" },
        { "a": "NaN", "b": "NaN", "c": "NaN" },
        { "a": "Infinity", "b": "Infinity", "c": "Infinity" },
        { "a": "+1", "b": "+1", "c": "+1" },
        { "a": "1_000", "b": "1_000", "c": "1_000" },
        { "a": "1e400", "b": "1e400", "c": "1e400" },
        { "a": "-0", "b": "-0", "c": "-0" },
        { "a": "", "b": "", "c": "" },
        { "a": "abc", "b": "abc", "c": "abc" },
        { "a": "1.9", "b": "1.9", "c": "1.9" },
        { "a": "2147483648", "b": "2147483648", "c": "2147483648" },
        { "a": "-2147483649", "b": "-2147483649", "c": "-2147483649" },
        { "a": "1e3", "b": "1e3", "c": "1e3" },
        { "a": "\u0663", "b": "\u0663", "c": "\u0663" },
        { "a": "\u2460", "b": "\u2460", "c": "\u2460" }
      ],
      "expect": {
        "rows": [
          { "a": 1.0, "b": 1.0, "c": 1.0 },
          { "a": 1.0, "b": 1.0, "c": 1.0 },
          { "a": 1.0, "b": 1.0, "c": 1.0 },
          { "a": 1.0, "b": 1.0, "c": 1.0 },
          { "a": 8.0, "b": 8.0, "c": 8.0 },
          { "a": null, "b": null, "c": null },
          { "a": { "$double": "NaN" }, "b": { "$double": "NaN" }, "c": { "$double": "NaN" } },
          {
            "a": { "$double": "Infinity" },
            "b": { "$double": "Infinity" },
            "c": { "$double": "Infinity" }
          },
          { "a": 1.0, "b": 1.0, "c": 1.0 },
          { "a": null, "b": null, "c": null },
          {
            "a": { "$double": "Infinity" },
            "b": { "$double": "Infinity" },
            "c": { "$double": "Infinity" }
          },
          { "a": { "$double": "-0.0" }, "b": { "$double": "-0.0" }, "c": { "$double": "-0.0" } },
          { "a": null, "b": null, "c": null },
          { "a": null, "b": null, "c": null },
          { "a": 1.9, "b": 1.9, "c": 1.9 },
          { "a": 2147483648.0, "b": 2147483648.0, "c": 2147483648.0 },
          { "a": -2147483649.0, "b": -2147483649.0, "c": -2147483649.0 },
          { "a": 1000.0, "b": 1000.0, "c": 1000.0 },
          { "a": null, "b": null, "c": null },
          { "a": null, "b": null, "c": null }
        ]
      }
    },
    {
