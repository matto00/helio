{
  "kind": "sort",
  "vectors": [
    {
      "name": "spike trap: a mixed column sorts in three tiers ascending",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [
        { "v": 10.0, "i": 0.0 },
        { "v": "9", "i": 1.0 },
        { "v": "abc", "i": 2.0 },
        { "v": null, "i": 3.0 },
        { "v": "2", "i": 4.0 },
        { "v": 3.5, "i": 5.0 },
        { "v": "Abc", "i": 6.0 },
        { "v": "10", "i": 7.0 }
      ],
      "expect": {
        "rows": [
          { "i": 4.0, "v": "2" },
          { "i": 5.0, "v": 3.5 },
          { "i": 1.0, "v": "9" },
          { "i": 0.0, "v": 10.0 },
          { "i": 7.0, "v": "10" },
          { "i": 6.0, "v": "Abc" },
          { "i": 2.0, "v": "abc" },
          { "i": 3.0, "v": null }
        ]
      }
    },
    {
      "name": "spike trap: the mixed column descending reverses the tiers, nulls stay last",
      "config": { "sortBy": [{ "field": "v", "direction": "desc" }] },
      "inputRows": [
        { "v": 10.0, "i": 0.0 },
        { "v": "9", "i": 1.0 },
        { "v": "abc", "i": 2.0 },
        { "v": null, "i": 3.0 },
        { "v": "2", "i": 4.0 },
        { "v": 3.5, "i": 5.0 },
        { "v": "Abc", "i": 6.0 },
        { "v": "10", "i": 7.0 }
      ],
      "expect": {
        "rows": [
          { "i": 2.0, "v": "abc" },
          { "i": 6.0, "v": "Abc" },
          { "i": 0.0, "v": 10.0 },
          { "i": 7.0, "v": "10" },
          { "i": 1.0, "v": "9" },
          { "i": 5.0, "v": 3.5 },
          { "i": 4.0, "v": "2" },
          { "i": 3.0, "v": null }
        ]
      }
    },
    {
      "name": "numeric-parse traps ascending",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [
        { "v": "1d", "i": 0.0 },
        { "v": "1f", "i": 1.0 },
        { "v": " 1 ", "i": 2.0 },
        { "v": "0x1p3", "i": 3.0 },
        { "v": "0x10", "i": 4.0 },
        { "v": "NaN", "i": 5.0 },
        { "v": "Infinity", "i": 6.0 },
        { "v": "+1", "i": 7.0 },
        { "v": "2", "i": 8.0 },
        { "v": "abc", "i": 9.0 },
        { "v": "-Infinity", "i": 10.0 },
        { "v": "10", "i": 11.0 }
      ],
      "expect": {
        "rows": [
          { "i": 0.0, "v": "1d" },
          { "i": 1.0, "v": "1f" },
          { "i": 2.0, "v": " 1 " },
          { "i": 7.0, "v": "+1" },
          { "i": 8.0, "v": "2" },
          { "i": 3.0, "v": "0x1p3" },
          { "i": 11.0, "v": "10" },
          { "i": 10.0, "v": "-Infinity" },
          { "i": 4.0, "v": "0x10" },
          { "i": 6.0, "v": "Infinity" },
          { "i": 5.0, "v": "NaN" },
          { "i": 9.0, "v": "abc" }
        ]
      }
    },
    {
      "name": "numeric-parse traps descending",
      "config": { "sortBy": [{ "field": "v", "direction": "desc" }] },
      "inputRows": [
        { "v": "1d", "i": 0.0 },
        { "v": "1f", "i": 1.0 },
        { "v": " 1 ", "i": 2.0 },
        { "v": "0x1p3", "i": 3.0 },
        { "v": "0x10", "i": 4.0 },
        { "v": "NaN", "i": 5.0 },
        { "v": "Infinity", "i": 6.0 },
        { "v": "+1", "i": 7.0 },
        { "v": "2", "i": 8.0 },
        { "v": "abc", "i": 9.0 },
        { "v": "-Infinity", "i": 10.0 },
        { "v": "10", "i": 11.0 }
      ],
      "expect": {
        "rows": [
          { "i": 9.0, "v": "abc" },
          { "i": 5.0, "v": "NaN" },
          { "i": 6.0, "v": "Infinity" },
          { "i": 4.0, "v": "0x10" },
          { "i": 10.0, "v": "-Infinity" },
          { "i": 11.0, "v": "10" },
          { "i": 3.0, "v": "0x1p3" },
          { "i": 8.0, "v": "2" },
          { "i": 0.0, "v": "1d" },
          { "i": 1.0, "v": "1f" },
          { "i": 2.0, "v": " 1 " },
          { "i": 7.0, "v": "+1" }
        ]
      }
    },
    {
      "name": "multi-key: the first key is primary, ties fall to the second",
      "config": {
        "sortBy": [
          { "field": "g", "direction": "asc" },
          { "field": "n", "direction": "desc" }
        ]
      },
      "inputRows": [
        { "g": "b", "n": 1.0 },
        { "g": "a", "n": 1.0 },
        { "g": "a", "n": 3.0 },
        { "g": "b", "n": 2.0 }
      ],
      "expect": {
        "rows": [
          { "g": "a", "n": 3.0 },
          { "g": "a", "n": 1.0 },
          { "g": "b", "n": 2.0 },
          { "g": "b", "n": 1.0 }
        ]
      }
    },
    {
      "name": "a stable sort keeps the input order of equal keys",
      "config": { "sortBy": [{ "field": "g", "direction": "asc" }] },
      "inputRows": [
        { "g": "a", "i": 1.0 },
        { "g": "b", "i": 2.0 },
        { "g": "a", "i": 3.0 },
        { "g": "b", "i": 4.0 }
      ],
      "expect": {
        "rows": [
          { "g": "a", "i": 1.0 },
          { "g": "a", "i": 3.0 },
          { "g": "b", "i": 2.0 },
          { "g": "b", "i": 4.0 }
        ]
      }
    },
    {
      "name": "a number and its numeric string tie and keep input order",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [
        { "v": "9", "i": 1.0 },
        { "v": 9.0, "i": 2.0 },
        { "v": { "$int": 9 }, "i": 3.0 }
      ],
      "expect": {
        "rows": [
          { "i": 1.0, "v": "9" },
          { "i": 2.0, "v": 9.0 },
          { "i": 3.0, "v": { "$int": 9 } }
        ]
      }
    },
    {
      "name": "nulls sort last in both directions",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [
        { "v": null, "i": 1.0 },
        { "v": 2.0, "i": 2.0 },
        { "i": 3.0 },
        { "v": 1.0, "i": 4.0 }
      ],
      "expect": {
        "rows": [
          { "i": 4.0, "v": 1.0 },
          { "i": 2.0, "v": 2.0 },
          { "i": 1.0, "v": null },
          { "i": 3.0 }
        ]
      }
    },
    {
      "name": "integral and double values compare numerically",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [{ "v": { "$int": 3 } }, { "v": 2.5 }, { "v": { "$long": "2" } }, { "v": 10.0 }],
      "expect": {
        "rows": [{ "v": { "$long": "2" } }, { "v": 2.5 }, { "v": { "$int": 3 } }, { "v": 10.0 }]
      }
    },
    {
      "name": "negative zero sorts before zero",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [
        { "v": 0.0, "i": 1.0 },
        { "v": { "$double": "-0.0" }, "i": 2.0 }
      ],
      "expect": {
        "rows": [
          { "i": 2.0, "v": { "$double": "-0.0" } },
          { "i": 1.0, "v": 0.0 }
        ]
      }
    },
    {
      "name": "NaN and Infinity doubles sort as text, after the finite numbers",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [
        { "v": { "$double": "NaN" } },
        { "v": 1.0 },
        { "v": { "$double": "Infinity" } },
        { "v": { "$double": "-Infinity" } },
        { "v": "abc" }
      ],
      "expect": {
        "rows": [
          { "v": 1.0 },
          { "v": { "$double": "-Infinity" } },
          { "v": { "$double": "Infinity" } },
          { "v": { "$double": "NaN" } },
          { "v": "abc" }
        ]
      }
    },
    {
      "name": "booleans sort as text",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [{ "v": true }, { "v": "tx" }, { "v": false }, { "v": 5.0 }],
      "expect": { "rows": [{ "v": 5.0 }, { "v": false }, { "v": true }, { "v": "tx" }] }
    },
    {
      "name": "the direction is matched case-insensitively",
      "config": { "sortBy": [{ "field": "v", "direction": "DESC" }] },
      "inputRows": [{ "v": 1.0 }, { "v": 3.0 }, { "v": 2.0 }],
      "expect": { "rows": [{ "v": 3.0 }, { "v": 2.0 }, { "v": 1.0 }] }
    },
    {
      "name": "an unknown direction sorts ascending",
      "config": { "sortBy": [{ "field": "v", "direction": "sideways" }] },
      "inputRows": [{ "v": 3.0 }, { "v": 1.0 }],
      "expect": { "rows": [{ "v": 1.0 }, { "v": 3.0 }] }
    },
    {
      "name": "a key with an empty field is skipped",
      "config": {
        "sortBy": [
          { "field": "", "direction": "asc" },
          { "field": "v", "direction": "asc" }
        ]
      },
      "inputRows": [{ "v": 2.0 }, { "v": 1.0 }],
      "expect": { "rows": [{ "v": 1.0 }, { "v": 2.0 }] }
    },
    {
      "name": "no sort keys keeps the order",
      "config": { "sortBy": [] },
      "inputRows": [{ "v": 2.0 }, { "v": 1.0 }],
      "expect": { "rows": [{ "v": 2.0 }, { "v": 1.0 }] }
    },
    {
      "name": "text compares by UTF-16 code unit",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [{ "v": "b" }, { "v": "B" }, { "v": "a" }, { "v": "\u00e9" }, { "v": "Z" }],
      "expect": {
        "rows": [{ "v": "B" }, { "v": "Z" }, { "v": "a" }, { "v": "b" }, { "v": "\u00e9" }]
      }
    },
    {
      "name": "large and small decimals",
      "config": { "sortBy": [{ "field": "v", "direction": "asc" }] },
      "inputRows": [{ "v": "1e3" }, { "v": "999" }, { "v": ".5" }, { "v": "5." }, { "v": "1_0" }],
      "expect": {
        "rows": [{ "v": ".5" }, { "v": "5." }, { "v": "999" }, { "v": "1e3" }, { "v": "1_0" }]
      }
    },
    {
      "name": "a sort key without a direction cannot be decoded",
      "config": { "sortBy": [{ "field": "v" }] },
      "inputRows": [{ "v": 1.0 }],
      "expect": { "error": true }
    },
