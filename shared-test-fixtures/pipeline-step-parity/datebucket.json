{
  "kind": "datebucket",
  "vectors": [
    {
      "name": "day floors to the date string",
      "config": { "field": "t", "granularity": "day" },
      "inputRows": [
        { "t": "2026-10-01T13:45:00Z" },
        { "t": "2026-10-04T13:45:00Z" },
        { "t": "2026-10-05T13:45:00Z" }
      ],
      "expect": { "rows": [{ "t": "2026-10-01" }, { "t": "2026-10-04" }, { "t": "2026-10-05" }] }
    },
    {
      "name": "week floors to the Monday",
      "config": { "field": "t", "granularity": "week" },
      "inputRows": [
        { "t": "2026-10-01" },
        { "t": "2026-10-04" },
        { "t": "2026-10-05" },
        { "t": "2026-12-31" },
        { "t": "2027-01-01" },
        { "t": "2024-02-29" },
        { "t": "2026-03-31" },
        { "t": "2026-04-01" },
        { "t": "2026-06-30" },
        { "t": "2026-07-01" },
        { "t": "2020-01-05" }
      ],
      "expect": {
        "rows": [
          { "t": "2026-09-28" },
          { "t": "2026-09-28" },
          { "t": "2026-10-05" },
          { "t": "2026-12-28" },
          { "t": "2026-12-28" },
          { "t": "2024-02-26" },
          { "t": "2026-03-30" },
          { "t": "2026-03-30" },
          { "t": "2026-06-29" },
          { "t": "2026-06-29" },
          { "t": "2019-12-30" }
        ]
      }
    },
    {
      "name": "month floors to the first",
      "config": { "field": "t", "granularity": "month" },
      "inputRows": [
        { "t": "2026-10-01" },
        { "t": "2026-10-04" },
        { "t": "2026-10-05" },
        { "t": "2026-12-31" },
        { "t": "2027-01-01" },
        { "t": "2024-02-29" },
        { "t": "2026-03-31" },
        { "t": "2026-04-01" },
        { "t": "2026-06-30" },
        { "t": "2026-07-01" },
        { "t": "2020-01-05" }
      ],
      "expect": {
        "rows": [
          { "t": "2026-10-01" },
          { "t": "2026-10-01" },
          { "t": "2026-10-01" },
          { "t": "2026-12-01" },
          { "t": "2027-01-01" },
          { "t": "2024-02-01" },
          { "t": "2026-03-01" },
          { "t": "2026-04-01" },
          { "t": "2026-06-01" },
          { "t": "2026-07-01" },
          { "t": "2020-01-01" }
        ]
      }
    },
    {
      "name": "quarter floors to the first of the quarter",
      "config": { "field": "t", "granularity": "quarter" },
      "inputRows": [
        { "t": "2026-10-01" },
        { "t": "2026-10-04" },
        { "t": "2026-10-05" },
        { "t": "2026-12-31" },
        { "t": "2027-01-01" },
        { "t": "2024-02-29" },
        { "t": "2026-03-31" },
        { "t": "2026-04-01" },
        { "t": "2026-06-30" },
        { "t": "2026-07-01" },
        { "t": "2020-01-05" }
      ],
      "expect": {
        "rows": [
          { "t": "2026-10-01" },
          { "t": "2026-10-01" },
          { "t": "2026-10-01" },
          { "t": "2026-10-01" },
          { "t": "2027-01-01" },
          { "t": "2024-01-01" },
          { "t": "2026-01-01" },
          { "t": "2026-04-01" },
          { "t": "2026-04-01" },
          { "t": "2026-07-01" },
          { "t": "2020-01-01" }
        ]
      }
    },
    {
      "name": "year floors to January 1",
      "config": { "field": "t", "granularity": "year" },
      "inputRows": [
        { "t": "2026-10-01" },
        { "t": "2026-10-04" },
        { "t": "2026-10-05" },
        { "t": "2026-12-31" },
        { "t": "2027-01-01" },
        { "t": "2024-02-29" },
        { "t": "2026-03-31" },
        { "t": "2026-04-01" },
        { "t": "2026-06-30" },
        { "t": "2026-07-01" },
        { "t": "2020-01-05" }
      ],
      "expect": {
        "rows": [
          { "t": "2026-01-01" },
          { "t": "2026-01-01" },
          { "t": "2026-01-01" },
          { "t": "2026-01-01" },
          { "t": "2027-01-01" },
          { "t": "2024-01-01" },
          { "t": "2026-01-01" },
          { "t": "2026-01-01" },
          { "t": "2026-01-01" },
          { "t": "2026-01-01" },
          { "t": "2020-01-01" }
        ]
      }
    },
    {
      "name": "mixed input shapes: offsets, epoch numbers and strings, space separator, US dates",
      "config": { "field": "t", "granularity": "day" },
      "inputRows": [
        { "t": "2026-10-01T23:30:00-05:00" },
        { "t": "2026-10-01 08:15:00" },
        { "t": "10/05/2026" },
        { "t": 1700000000.0 },
        { "t": "1700000000" },
        { "t": 1700000000000.0 },
        { "t": { "$int": 86400 } },
        { "t": "2026-10-01T00:00:00+02:00" },
        { "t": "2026-10-01 23:59:59.999999999" }
      ],
      "expect": {
        "rows": [
          { "t": "2026-10-02" },
          { "t": "2026-10-01" },
          { "t": "2026-10-05" },
          { "t": "2023-11-14" },
          { "t": "2023-11-14" },
          { "t": "2023-11-14" },
          { "t": "1970-01-02" },
          { "t": "2026-09-30" },
          { "t": "2026-10-01" }
        ]
      }
    },
    {
      "name": "unparseable, null and blank inputs become null while others bucket",
      "config": { "field": "t", "granularity": "month" },
      "inputRows": [
        { "t": "2026-10-17" },
        { "t": "garbage" },
        { "t": null },
        { "t": "" },
        { "t": "  " },
        { "t": true },
        { "t": 1.5 },
        { "t": { "$double": "NaN" } }
      ],
      "expect": {
        "rows": [
          { "t": "2026-10-01" },
          { "t": null },
          { "t": null },
          { "t": null },
          { "t": null },
          { "t": null },
          { "t": null },
          { "t": null }
        ]
      }
    },
    {
      "name": "a custom output column leaves the input alone",
      "config": { "field": "t", "granularity": "day", "outputColumn": "d" },
      "inputRows": [{ "t": "2026-10-17T12:00:00Z" }],
      "expect": { "rows": [{ "d": "2026-10-17", "t": "2026-10-17T12:00:00Z" }] }
    },
    {
      "name": "an empty output column name falls back to the field",
      "config": { "field": "t", "granularity": "day", "outputColumn": "" },
      "inputRows": [{ "t": "2026-10-17" }],
      "expect": { "rows": [{ "t": "2026-10-17" }] }
    },
    {
      "name": "a missing field reads as null; blank everywhere is not an error",
      "config": { "field": "gone", "granularity": "day" },
      "inputRows": [{ "a": 1.0 }],
      "expect": { "rows": [{ "a": 1.0, "gone": null }] }
    },
    {
      "name": "nothing parseable but non-blank values is a step error",
      "config": { "field": "t", "granularity": "day" },
      "inputRows": [{ "t": "garbage" }, { "t": "also garbage" }],
      "expect": { "error": true }
    },
    {
      "name": "an unsupported granularity is a step error even with no rows",
      "config": { "field": "t", "granularity": "hour" },
      "inputRows": [],
      "expect": { "error": true }
    },
    {
      "name": "the granularity is case-sensitive",
      "config": { "field": "t", "granularity": "Day" },
      "inputRows": [{ "t": "2026-10-17" }],
      "expect": { "error": true }
    },
    {
      "name": "a blank field name is a step error",
      "config": { "field": "", "granularity": "day" },
      "inputRows": [{ "t": "2026-10-17" }],
      "expect": { "error": true }
    },
    {
      "name": "pre-1970 and year boundaries",
      "config": { "field": "t", "granularity": "week" },
      "inputRows": [
        { "t": "1969-12-31" },
        { "t": "1970-01-01" },
        { "t": "0001-01-01" },
        { "t": "9999-12-31" },
        { "t": "2025-12-29" },
        { "t": "2026-01-01" }
      ],
      "expect": {
        "rows": [
          { "t": "1969-12-29" },
          { "t": "1969-12-29" },
          { "t": "0001-01-01" },
          { "t": "9999-12-27" },
          { "t": "2025-12-29" },
          { "t": "2025-12-29" }
        ]
      }
    },
    {
      "name": "a disabled datebucket is transparent",
      "config": { "field": "t", "granularity": "day" },
      "inputRows": [{ "t": "2026-10-17" }],
      "enabled": false,
      "expect": { "rows": [{ "t": "2026-10-17" }] }
    },
    {
      "name": "Unicode-digit epoch strings bucket like ASCII ones",
      "config": { "field": "t", "granularity": "day" },
      "inputRows": [
        { "t": "\u0661\u0667\u0660\u0660\u0660\u0660\u0660\u0660\u0660\u0660" },
        { "t": "\uff11\uff17\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10" },
        { "t": "\u0967\u096d\u0966\u0966\u0966\u0966\u0966\u0966\u0966\u0966" },
        { "t": "\u0663" },
        { "t": "\uff11.\uff10" },
        { "t": "\uff11e\uff13" }
      ],
      "expect": {
        "rows": [
          { "t": "2023-11-14" },
          { "t": "2023-11-14" },
          { "t": "2023-11-14" },
          { "t": "1970-01-01" },
          { "t": "1970-01-01" },
          { "t": "1970-01-01" }
        ]
      }
    },
    {
      "name": "a frame where every value is a Unicode-digit epoch string is not an error",
      "config": { "field": "t", "granularity": "month" },
      "inputRows": [
        { "t": "\uff11\uff17\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10" },
        { "t": "\u0661\u0667\u0660\u0660\u0660\u0660\u0660\u0660\u0660\u0660" }
      ],
      "expect": { "rows": [{ "t": "2023-11-01" }, { "t": "2023-11-01" }] }
    },
    {
      "name": "Unicode-digit strings that are not whole numbers or out of range are unparseable",
      "config": { "field": "t", "granularity": "day", "outputColumn": "d" },
      "inputRows": [
        { "t": "\uff11.\uff15" },
        { "t": "\uff11\uff17\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10" },
        {
          "t": "\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19"
        }
      ],
      "expect": {
        "rows": [
          { "d": null, "t": "\uff11.\uff15" },
          {
            "d": "2023-11-14",
            "t": "\uff11\uff17\uff10\uff10\uff10\uff10\uff10\uff10\uff10\uff10"
          },
          {
            "d": null,
            "t": "\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19\uff19"
          }
        ]
      }
    }
  ]
}
