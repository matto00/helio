  "group": [
    {
      "name": "numeric keys use ES Number toString",
      "rows": [
        {
          "k": 1,
          "y": 1
        },
        {
          "k": 2.5,
          "y": 2
        },
        {
          "k": 1e21,
          "y": 3
        },
        {
          "k": 1e-7,
          "y": 4
        },
        {
          "k": 9223372036854775808,
          "y": 5
        },
        {
          "k": 100000000000000000000,
          "y": 6
        },
        {
          "k": 9007199254740993,
          "y": 7
        },
        {
          "k": -0,
          "y": 8
        },
        {
          "k": 1.5e-7,
          "y": 9
        },
        {
          "k": 123.456,
          "y": 10
        },
        {
          "k": 5e-324,
          "y": 11
        },
        {
          "k": 1e-323,
          "y": 12
        },
        {
          "k": 0.000001,
          "y": 13
        },
        {
          "k": -1.5,
          "y": 14
        }
      ],
      "groupBy": "k",
      "agg": "sum",
      "yField": "y",
      "expected": {
        "categories": [
          "-1.5",
          "0",
          "0.000001",
          "1",
          "1.5e-7",
          "100000000000000000000",
          "123.456",
          "1e+21",
          "1e-323",
          "1e-7",
          "2.5",
          "5e-324",
          "9007199254740992",
          "9223372036854776000"
        ],
        "values": [14, 8, 13, 1, 9, 6, 10, 3, 12, 4, 2, 11, 7, 5]
      }
    },
    {
      "name": "non-numeric keys",
      "rows": [
        {
          "k": "b",
          "y": "1"
        },
        {
          "k": "a",
          "y": "2"
        },
        {
          "k": "b",
          "y": "3"
        },
        {
          "k": null,
          "y": 4
        },
        {
          "y": 5
        },
        {
          "k": true,
          "y": 6
        },
        {
          "k": false,
          "y": 7
        },
        {
          "k": "B",
          "y": 8
        }
      ],
      "groupBy": "k",
      "agg": "sum",
      "yField": "y",
      "expected": {
        "categories": ["B", "a", "b", "false", "null", "true", "undefined"],
        "values": [8, 2, 4, 7, 4, 6, 5]
      }
    },
    {
      "name": "group avg with non-coercible group",
      "rows": [
        {
          "k": "a",
          "y": "x"
        },
        {
          "k": "b",
          "y": "4"
        },
        {
          "k": "b",
          "y": 6
        }
      ],
      "groupBy": "k",
      "agg": "avg",
      "yField": "y",
      "expected": {
        "categories": ["a", "b"],
        "values": [0, 5]
      }
    },
    {
      "name": "group count",
      "rows": [
        {
          "k": "a",
          "y": null
        },
        {
          "k": "a",
          "y": 1
        },
        {
          "k": "b",
          "y": "z"
        }
      ],
      "groupBy": "k",
      "agg": "count",
      "yField": "y",
      "expected": {
        "categories": ["a", "b"],
        "values": [1, 1]
      }
    }
