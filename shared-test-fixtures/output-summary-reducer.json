        "aggregation": {
          "value": "amount",
          "agg": "sum"
        }
      },
      "expected": {
        "field": "amount",
        "agg": "sum"
      }
    },
    {
      "name": "lone label mapping with aggregation but no value",
      "config": {
        "fieldMapping": {
          "label": "name"
        },
        "aggregation": {
          "agg": "sum"
        }
      },
      "expected": null
    },
    {
      "name": "lone unvalidated legacy key",
      "config": {
        "fieldMapping": {
          "legacy": "amount"
        }
      },
      "expected": null
    },
    {
      "name": "empty config",
      "config": {},
      "expected": null
