  "metricField": [
    {
      "name": "value mapping only",
      "config": {
        "fieldMapping": {
          "value": "amount"
        }
      },
      "expected": {
        "field": "amount",
        "agg": null
      }
    },
    {
      "name": "value mapping with aggregation agg",
      "config": {
        "fieldMapping": {
          "value": "amount"
        },
        "aggregation": {
          "agg": "sum"
        }
      },
      "expected": {
        "field": "amount",
        "agg": "sum"
      }
    },
    {
      "name": "value mapping wins over aggregation value",
      "config": {
        "fieldMapping": {
          "value": "amount"
        },
        "aggregation": {
          "value": "other",
          "agg": "avg"
        }
      },
      "expected": {
        "field": "amount",
        "agg": "avg"
      }
    },
    {
      "name": "value and label mappings",
      "config": {
        "fieldMapping": {
          "value": "amount",
          "label": "name"
        }
      },
      "expected": {
        "field": "amount",
        "agg": null
      }
    },
    {
      "name": "aggregation value only",
      "config": {
        "aggregation": {
          "value": "amount",
          "agg": "max"
        }
      },
      "expected": {
        "field": "amount",
        "agg": "max"
      }
    },
    {
      "name": "lone label mapping",
