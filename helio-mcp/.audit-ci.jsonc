{
  // HEL-1204: fails CI on any moderate-or-higher npm advisory in the helio-mcp/ lockfile.
  // Deliberately stricter than the root config (`"high": true`; frontend/ is also at moderate, HEL-1320): helio-mcp is a
  // small, runtime-only dependency tree shipped to agent hosts, and every advisory that
  // motivated this gate (hono, ip-address, fast-uri) was MODERATE, so a `"high": true` config
  // would be green on a vulnerable lockfile. Accepted, un-fixable advisories go in `allowlist`
  // below as `"<GHSA>|<path-scope>*"` with an inline comment carrying the ticket, reason,
  // dependency path and a review-by date (HEL-1246 pattern) — never a bare GHSA id or a
  // package-wide wildcard. The allowlist is empty; the helio-mcp/ tree is clean at the moderate threshold (HEL-1319).
  "moderate": true,
  "allowlist": [],
}
