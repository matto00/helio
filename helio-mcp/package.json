{
  "name": "helio-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server exposing Helio's REST API as agent tools (read + workspace context). Standalone — not part of the root npm workspace.",
  "type": "module",
  "bin": {
    "helio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "tsx scripts/verify.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "qs": "^6.15.4"
  }
}
