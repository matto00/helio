{
  "name": "helio-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server exposing Helio's REST API as agent tools (read + workspace context). Standalone — not part of the root npm workspace.",
  "type": "module",
  "bin": {
    "helio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "tsx scripts/verify.ts",
    "verify:isolated": "tsx scripts/verifyIsolated.ts",
    "start:http": "node dist/http.js",
    "dev:http": "tsx src/http.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "fast-uri": "^3.1.9",
    "qs": "^6.17.1"
  }
}
