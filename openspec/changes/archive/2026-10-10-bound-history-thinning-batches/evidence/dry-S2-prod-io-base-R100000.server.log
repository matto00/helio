2026-10-10 05:46:56.555 UTC [20636] hel1435-S2-prod-io-base-R100000-b16-explain-r3 STATEMENT:  DELETE FROM output_snapshot_history WHERE output_id = ANY($1) AND id IN (
	             SELECT id FROM (
	               SELECT id, age_class, bucket,
	                      row_number() OVER w AS recency,
	                      lag(age_class) OVER w AS prev_class,
	                      lag(bucket) OVER w AS prev_bucket
	               FROM (
	                 SELECT id, output_id, captured_at,
	                        CASE WHEN extract(epoch FROM ($2::timestamptz - captured_at)) < $3 THEN 0
	                             WHEN extract(epoch FROM ($4::timestamptz - captured_at)) < $5 THEN 1
	                             ELSE 2 END AS age_class,
	                        floor(extract(epoch FROM captured_at) /
	                          CASE WHEN extract(epoch FROM ($6::timestamptz - captured_at)) < $7 THEN $8
	                               WHEN extract(epoch FROM ($9::timestamptz - captured_at)) < $10 THEN $11
	                               ELSE $12 END) AS bucket
	                 FROM output_snapshot_history
	                 WHERE output_id = ANY($13)
	               ) classed
	               WINDOW w AS (PARTITION BY output_id ORDER BY captured_at DESC, id DESC)
	             ) ranked
	             WHERE recency > $14 AND prev_class = age_class AND prev_bucket = bucket)
