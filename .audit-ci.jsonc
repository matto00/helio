{
  // HEL-459 / HEL-1364: fails CI on any moderate/high/critical npm advisory in the root lockfile
  // (matches frontend/ and helio-mcp/). Accepted, un-fixable advisories go in `allowlist` below
  // with an inline comment carrying the ticket and a review-by date — never a silent/blanket suppression.
  "moderate": true,
  "allowlist": [
    // HEL-1751: GHSA-fc5q-39xc-vjpf (picomatch ReDoS via single-branch repeated extglobs, <= 4.0.7) —
    // dev-only: `npm audit --omit=dev` is 0, every path below runs through dev/build tooling
    // (jest/jest-util (via jest-haste-map>anymatch, micromatch) and typescript-eslint>tinyglobby, fdir).
    // No patched release: 4.0.7 is the latest picomatch. audit-ci reports each path as a head-anchored
    // "a>b>picomatch" string whose head and trailing ">" vary run to run (npm audit key order), so a
    // verbatim per-path list is flaky. Instead there is one entry per package in picomatch's dev-only
    // transitive effects set (all "dev": true in the lockfile), each as "<full package name>>*": a path
    // must START at one of these dev packages. A production path starts at a production package, which
    // is not listed, so it still fails. Do NOT loosen to "picomatch*", "jest*" or a leading "*".
    // Re-derive the set from `npm audit --json` if the lockfile changes.
    // Review-by 2026-12-17; remove once picomatch > 4.0.7 ships.
    "GHSA-fc5q-39xc-vjpf|@jest/console>*",
    "GHSA-fc5q-39xc-vjpf|@jest/core>*",
    "GHSA-fc5q-39xc-vjpf|@jest/environment>*",
