{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/pipelines/draft-preview-request.schema.json",
  "title": "DraftPreviewRequest",
  "description": "Request body for POST /api/pipelines/:id/draft-preview (HEL-1630): the draft step configs from the first server-evaluated step downward plus the input frames they need, all supplied by the client. The server evaluates only these frames and never reads a data source. Caps (each violation is a 413 naming the cap): body 4 MiB, 10,000 rows per frame, 8 roots, 8 lanes, 8 sources, 50 steps, ids 64 characters. Cells are value-encoded losslessly: a JVM Int is {\"$int\": n}, a Long is {\"$long\": \"n\"}, NaN/Infinity/-Infinity/negative zero are {\"$double\": \"...\"}, and every other JSON number is a double. `roots` are synthetic client labels for input frames (never stored roots); a parentless step names its frame by `rootId`. `lanes` hold frames for lane references to steps outside `steps` (keys must not equal a step id). `sources` hold a join/union/lookup source secondary's rows; `complete: false` marks a partial cache, which makes the step unavailable (the server never completes it by reading). `listFrame` is accepted and ignored. `rowsStepId` defaults to the trunk terminal of roots[0].",
  "type": "object",
  "required": ["roots", "steps"],
  "properties": {
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "rows"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "rows": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/cell"
              }
            }
          },
          "listFrame": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "kind", "enabled", "position", "config"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "parentStepId": {
            "type": ["string", "null"],
            "maxLength": 64
          },
          "rootId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "position": {
            "type": "integer"
          },
          "config": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "required": ["rows"],
        "properties": {
          "rows": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/cell"
              }
            }
          },
          "listFrame": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "required": ["rows", "complete"],
        "properties": {
          "rows": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/cell"
              }
            }
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "rowsStepId": {
      "type": ["string", "null"],
      "maxLength": 64
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cell": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": ["$int"],
          "properties": {
            "$int": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["$long"],
          "properties": {
            "$long": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["$double"],
          "properties": {
            "$double": {
              "enum": ["NaN", "Infinity", "-Infinity", "-0.0"]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
