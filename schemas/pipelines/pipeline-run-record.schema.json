{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/pipelines/pipeline-run-record.schema.json",
  "title": "PipelineRunRecord",
  "description": "A single persisted pipeline run as returned by GET /api/pipelines/:id/run-history. `triggerSource` records how the run was started (HEL-417): `manual` (user-submitted via the run API, including dry runs), `scheduled` (fired by the scheduler runtime, HEL-415), or `external` (POST /api/hooks/run, HEL-369). `triggeredByTokenId` (HEL-369) is present when a PAT authenticated the triggering request. `assertions` (HEL-576) is the run's pass/fail-by-severity assertion summary -- always present, zero-valued when the pipeline had no `assert` steps.",
  "type": "object",
  "$defs": {
    "AssertionFailureDetail": {
      "type": "object",
      "description": "One failing assertion rule's detail. `failures` carries only the FAILED results.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "field": {
          "type": ["string", "null"]
        },
        "severity": {
          "type": "string",
          "enum": ["warn", "error"]
        },
        "message": {
          "type": ["string", "null"]
        }
      },
      "required": ["kind", "field", "severity", "message"],
      "additionalProperties": false
    },
    "AssertionSummary": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer"
        },
        "warnFailed": {
          "type": "integer"
        },
        "errorFailed": {
          "type": "integer"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssertionFailureDetail"
          }
        }
      },
      "required": ["passed", "warnFailed", "errorFailed", "failures"],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {
      "type": "string"
    },
    "pipelineId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "dry_run"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "rowCount": {
      "type": ["integer", "null"]
    },
    "errorLog": {
      "type": ["string", "null"]
    },
    "triggerSource": {
      "type": "string",
      "enum": ["manual", "scheduled", "external"]
    },
    "triggeredByTokenId": {
      "type": "string"
    },
    "assertions": {
      "$ref": "#/$defs/AssertionSummary"
    }
  },
  "required": [
    "id",
    "pipelineId",
    "status",
    "startedAt",
    "completedAt",
    "rowCount",
    "errorLog",
    "triggerSource",
    "assertions"
  ],
  "additionalProperties": false
}
