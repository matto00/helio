{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/pipelines/pipeline-analyze-response.schema.json",
  "title": "PipelineAnalyzeResponse",
  "type": "object",
  "required": ["id", "name", "sourceSchemas", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourceSchemas": {
      "description": "HEL-913 task 7.2c (pipeline-analyze-api spec delta): one entry per pipeline root, keyed by root id -- REPLACES the retired scalar sourceDataSourceName/sourceSchema pair outright (decision 11, no dual-read path).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RootSourceSchema"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnalyzeStep"
      }
    },
    "sourceSchemaDrift": {
      "$ref": "#/$defs/SourceSchemaDrift"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RootSourceSchema": {
      "type": "object",
      "required": ["rootId", "sourceDataSourceName", "sourceSchema"],
      "properties": {
        "rootId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDataSourceName": {
          "type": "string"
        },
        "sourceSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        }
      },
      "additionalProperties": false
    },
    "SchemaField": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "float",
            "boolean",
            "timestamp",
            "string-body",
            "binary-ref"
          ]
        }
      },
      "additionalProperties": false
    },
    "TypeChangedColumn": {
      "type": "object",
      "required": ["name", "previousType", "currentType"],
      "properties": {
        "name": {
          "type": "string"
        },
        "previousType": {
          "type": "string"
        },
        "currentType": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SourceSchemaDrift": {
      "type": "object",
      "required": ["addedColumns", "removedColumns", "typeChangedColumns"],
      "properties": {
        "addedColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        },
        "removedColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        },
        "typeChangedColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeChangedColumn"
          }
        }
      },
      "additionalProperties": false
    },
    "AnalyzeStep": {
      "type": "object",
      "required": ["id", "position", "op", "config", "inputSchema", "outputSchema"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "op": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "inputSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        },
        "outputSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchemaField"
          }
        },
        "validationError": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
