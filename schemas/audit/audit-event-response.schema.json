{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/audit/audit-event-response.schema.json",
  "title": "AuditEventResponse",
  "description": "A single audit event row as returned by GET /api/audit-events (HEL-488), nested inside the `items` array of that endpoint's PagedResult envelope. Owner-scoped: every row's actorUserId is the caller's own id.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "actorUserId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "actorTokenId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "enum": ["ui", "pat", "mcp", "system"],
      "description": "mcp is a legal wire value but is never actually produced today (see AuthDirectives) — see design.md Decision 6."
    },
    "action": {
      "type": "string"
    },
    "resourceType": {
      "type": "string"
    },
    "resourceId": {
      "type": ["string", "null"]
    },
    "metadata": {
      "description": "Free-form action-specific JSON payload."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "source", "action", "resourceType", "createdAt"],
  "additionalProperties": false
}
