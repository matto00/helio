{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/outputs/output.schema.json",
  "title": "OutputResponse",
  "description": "A panel-bindable projection of a single pipeline node (HEL-904/HEL-906). Replaces the DataType/Metric response shapes. `config` shape varies by `kind` (chart legend/tooltip/seriesColors/axisLabels for `chart`; `format` for `metric`/`collection`, HEL-876) and is carried as a raw object.",
  "type": "object",
  "required": [
    "id",
    "pipelineId",
    "nodeStepId",
    "ownerId",
    "name",
    "kind",
    "config",
    "schema",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "pipelineId": { "type": "string", "minLength": 1 },
    "nodeStepId": { "type": ["string", "null"] },
    "ownerId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["table", "metric", "chart", "collection", "timeline", "markdown"]
    },
    "config": { "type": "object" },
    "schema": {
      "type": "array",
      "items": { "$ref": "output-schema-field.schema.json" }
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": false
}
