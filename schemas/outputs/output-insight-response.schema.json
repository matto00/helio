{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/outputs/output-insight-response.schema.json",
  "title": "OutputInsightResponse",
  "description": "Response for GET /api/outputs/:id/insight (HEL-1742): the newest ok render (null when none) and the newest attempt of any status (null when none). A failed or skipped attempt never hides the last good render. Read-only: a read never regenerates anything. An unknown id, an Output the caller cannot read and a non-insight Output are all the same 404.",
  "type": "object",
  "properties": {
    "outputId": { "type": "string" },
    "render": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/render" }]
    },
    "lastAttempt": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/attempt" }]
    }
  },
  "required": ["outputId", "render", "lastAttempt"],
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "outputId": { "type": "string" },
        "field": { "type": "string" },
        "number": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "isPct": { "type": "boolean" }
      },
      "required": ["id", "outputId", "field", "isPct"],
      "additionalProperties": false
    },
    "trigger": { "type": "string", "enum": ["on_run", "daily", "manual", "pin"] },
    "render": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "markdown": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "trigger": { "$ref": "#/$defs/trigger" },
        "runId": { "type": "string" },
        "inputDigest": { "type": "string" },
        "model": { "type": "string" },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cacheCreationTokens": { "type": "integer", "minimum": 0 },
        "cacheReadTokens": { "type": "integer", "minimum": 0 },
        "costMicros": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "markdown", "citations", "trigger", "createdAt"],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["ok", "failed", "skipped_quota", "skipped_unchanged", "skipped_budget"]
        },
        "trigger": { "$ref": "#/$defs/trigger" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "status", "trigger", "createdAt"],
      "additionalProperties": false
    }
  }
}
