{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/auth/user-preferences.schema.json",
  "title": "UserPreferences",
  "description": "The signed-in user's saved preferences (HEL-1574), returned as `preferences` on every user-returning auth response and by PATCH /api/users/me/preferences. `contextListWidth`/`contextListCollapsed` are absent until the user sets them (the client then uses 248px, expanded). `typeStyle`, `density` and `motion` (HEL-1572) are likewise absent until set; `motion` absent means follow the OS reduce-motion setting. `dashboardTabs` (HEL-1575) is the saved open-tab set, absent until the user first opens a tab; `lastViewedAt`/`ownWriteAt` are server-time instants, omitted when never set.",
  "type": "object",
  "properties": {
    "accentColor": {
      "type": ["string", "null"]
    },
    "zoomLevels": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "contextListWidth": {
      "type": "integer",
      "minimum": 200,
      "maximum": 400
    },
    "contextListCollapsed": {
      "type": "boolean"
    },
    "typeStyle": {
      "type": "string",
      "enum": ["sans", "mono", "serif"]
    },
    "density": {
      "type": "string",
      "enum": ["comfortable", "compact"]
    },
    "motion": {
      "type": "string",
      "enum": ["full", "subtle", "off"]
    },
    "dashboardTabs": {
      "$ref": "#/$defs/DashboardTabsPref"
    }
  },
  "required": ["zoomLevels"],
  "additionalProperties": false,
  "$defs": {
    "DashboardTabsPref": {
      "type": "object",
      "properties": {
        "tabs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/DashboardTabPref"
          }
        },
        "activeId": {
          "type": ["string", "null"]
        }
      },
      "required": ["tabs"],
      "additionalProperties": false,
      "title": "DashboardTabsPref"
    },
    "DashboardTabPref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lastViewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ownWriteAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["id"],
      "additionalProperties": false,
      "title": "DashboardTabPref"
    }
  }
}
