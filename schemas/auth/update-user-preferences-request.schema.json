{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/auth/update-user-preferences-request.schema.json",
  "title": "UpdateShellPreferencesRequest",
  "description": "Body of PATCH /api/users/me/preferences (HEL-1574): any non-empty subset of the shell keys and, since HEL-1575, `dashboardTabs` (replaces the stored tab set as a whole: at most 20 tabs, unique non-empty ids of at most 64 characters, `activeId` null or one of the tab ids); unknown fields and out-of-range values are rejected with 400. Only the fields present are stored.",
  "type": "object",
  "properties": {
    "contextListWidth": {
      "type": "integer",
      "minimum": 200,
      "maximum": 400
    },
    "contextListCollapsed": {
      "type": "boolean"
    },
    "dashboardTabs": {
      "$ref": "#/$defs/DashboardTabsPref"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "DashboardTabsPref": {
      "type": "object",
      "properties": {
        "tabs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/DashboardTabPref"
          }
        },
        "activeId": {
          "type": ["string", "null"]
        }
      },
      "required": ["tabs"],
      "additionalProperties": false,
      "title": "DashboardTabsPref"
    },
    "DashboardTabPref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lastViewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ownWriteAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": ["id"],
      "additionalProperties": false,
      "title": "DashboardTabPref"
    }
  }
}
