{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/auth/mfa-status-response.schema.json",
  "title": "MfaStatusResponse",
  "description": "GET /api/auth/mfa — the acting user's MFA enrollment state.",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "backupCodesRemaining": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["enabled", "backupCodesRemaining"],
  "additionalProperties": false
}
