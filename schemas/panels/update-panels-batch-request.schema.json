{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/panels/update-panels-batch-request.schema.json",
  "title": "UpdatePanelsBatchRequest",
  "description": "Payload for POST /api/panels/updateBatch. Each entry's `config` (when present) carries a typed patch whose shape matches the panel's `type`.",
  "type": "object",
  "required": ["fields", "panels"],
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of the fields being updated across the batch (e.g. [\"appearance\"], [\"title\"], [\"config\"])"
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["text", "markdown", "image", "divider", "output"]
          },
          "appearance": {
            "$ref": "panel-appearance-patch.schema.json"
          },
          "config": {
            "type": "object"
          }
        }
      }
    }
  }
}
