{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/panels/create-panel-request.schema.json",
  "title": "CreatePanelRequest",
  "description": "Discriminated create-panel payload — `type` selects the shape of `config`. `config` is optional; an empty/absent value falls back to the subtype's defaults (codec read-path tolerance rule). `appearance` is optional (same shape as the PATCH appearance); when present it is validated (including `chartType` against the allowed set) and stored on the created panel in place of the default appearance.",
  "type": "object",
  "required": ["dashboardId"],
  "properties": {
    "dashboardId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "type": {
      "type": "string",
      "enum": ["text", "markdown", "image", "divider", "output"]
    },
    "config": {
      "type": "object"
    },
    "appearance": {
      "$ref": "panel-appearance.schema.json"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "output"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "panel.schema.json#/$defs/OutputConfig"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "text"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "panel.schema.json#/$defs/TextConfig"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "markdown"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "panel.schema.json#/$defs/MarkdownConfig"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "image"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "panel.schema.json#/$defs/ImageConfig"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "divider"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "config": {
            "$ref": "panel.schema.json#/$defs/DividerConfig"
          }
        }
      }
    }
  ]
}
