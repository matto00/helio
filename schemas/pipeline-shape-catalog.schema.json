{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/pipeline-shape-catalog.schema.json",
  "title": "PipelineShapeCatalogEntryResponse",
  "description": "One entry of the `GET /api/pipeline-shapes` catalog response array (HEL-391) -- one per `PipelineShape.Registry` value. The endpoint response body is a JSON array of this shape.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "Stable shape identifier, e.g. \"passthrough\"." },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "paramsSchema": {
      "type": "array",
      "description": "Descriptive metadata for every param the shape's `expand` accepts -- descriptors only, never values.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "dataType": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "required": ["name", "label", "dataType", "required", "description"],
        "additionalProperties": false
      }
    },
    "outputContract": {
      "type": "object",
      "description": "The shape's guaranteed output shape -- declared once per shape, not per invocation.",
      "properties": {
        "rowCount": {
          "type": "object",
          "description": "Discriminated union: kind \"exactly-one\" | \"at-most-param\" | \"unbounded\". `paramName` is present only for \"at-most-param\".",
          "properties": {
            "kind": { "type": "string", "enum": ["exactly-one", "at-most-param", "unbounded"] },
            "paramName": { "type": "string" }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "description": "Statically-known output fields. Empty when the field set is fully determined by caller-supplied params.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "dataType": { "type": "string" },
              "nullable": { "type": "boolean" }
            },
            "required": ["name", "dataType", "nullable"],
            "additionalProperties": false
          }
        },
        "description": { "type": "string" }
      },
      "required": ["rowCount", "fields", "description"],
      "additionalProperties": false
    }
  },
  "required": ["id", "label", "description", "paramsSchema", "outputContract"],
  "additionalProperties": false
}
