{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/dashboards/dashboard.schema.json",
  "title": "Dashboard",
  "type": "object",
  "required": ["id", "name", "meta", "appearance", "layout", "ownerId", "layoutVersion"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "meta": {
      "$ref": "https://helio.local/schemas/shared/resource-meta.schema.json"
    },
    "appearance": {
      "$ref": "https://helio.local/schemas/dashboards/dashboard-appearance.schema.json"
    },
    "layout": {
      "$ref": "https://helio.local/schemas/dashboards/dashboard-layout.schema.json"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "layoutVersion": {
      "type": "integer",
      "minimum": 0,
      "description": "HEL-1457: database-maintained, bumped whenever the stored layout changes (any writer). Echo it as `expectedLayoutVersion` on a layout PATCH or auto-layout to have a stale write refused with 409 instead of overwriting."
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "HEL-907 evaluator-final-2 (V95, cycle 17/20): optional free-form grouping tag, set only at create time. Omitted on the wire when null (spray-json drops `Option = None`)."
    }
  },
  "additionalProperties": false
}
