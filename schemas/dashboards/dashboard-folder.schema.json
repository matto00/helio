{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/dashboards/dashboard-folder.schema.json",
  "title": "DashboardFolderResponse",
  "description": "A per-user dashboard folder (HEL-1574).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "collapsed": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "name", "collapsed", "createdAt"],
  "additionalProperties": false
}
