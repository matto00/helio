{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helio.local/schemas/alerts/alert-rule.schema.json",
  "title": "AlertRuleResponse",
  "description": "An alert rule as returned by GET/POST/PATCH /api/alert-rules. `condition` is a JSON object (comparator + threshold, optionally a history baseline: `baseline`/`n`/`mode`, plus window params) — unknown/extra keys survive a round-trip unchanged so future condition kinds don't require a schema change.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "targetOutputId": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "condition": {
      "type": "object",
      "properties": {
        "comparator": {
          "type": "string",
          "enum": ["gt", "gte", "lt", "lte", "eq", "neq"]
        },
        "threshold": {
          "type": "number"
        },
        "window": {
          "type": "string"
        },
        "baseline": {
          "type": "string",
          "enum": ["previous", "rolling_avg"]
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "mode": {
          "type": "string",
          "enum": ["abs", "pct"]
        }
      }
    },
    "name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "ownerId",
    "targetOutputId",
    "metric",
    "condition",
    "name",
    "enabled",
    "severity",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
