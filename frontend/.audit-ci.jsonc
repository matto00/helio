    "GHSA-fc5q-39xc-vjpf|expect>*",
    "GHSA-fc5q-39xc-vjpf|fdir>*",
    "GHSA-fc5q-39xc-vjpf|jest>*",
    "GHSA-fc5q-39xc-vjpf|jest-changed-files>*",
    "GHSA-fc5q-39xc-vjpf|jest-circus>*",
    "GHSA-fc5q-39xc-vjpf|jest-cli>*",
