{
  // HEL-459 / HEL-1320: fails CI on any moderate-or-higher npm advisory in the frontend/ lockfile
  // (matches helio-mcp/, HEL-1204; a "high" threshold stayed green on moderate advisories). Accepted,
  // un-fixable advisories go in `allowlist` below as `"<GHSA>|<path-scope>*"` with an inline comment
  // carrying the ticket, reason, dependency path and a review-by date (HEL-1246 pattern) — never a
  // bare GHSA id or a package-wide wildcard.
  "moderate": true,
  "allowlist": [
    // HEL-1751: GHSA-fc5q-39xc-vjpf (picomatch ReDoS via single-branch repeated extglobs, <= 4.0.7) —
    // dev-only: `npm audit --omit=dev` is 0, every path below runs through dev/build tooling
    // (jest/jest-util/jest-message-util (via jest-haste-map>anymatch), vite/tinyglobby/fdir,
    // rollup plugins (@rollup/pluginutils), vite-plugin-pwa>workbox-build, rollup-plugin-visualizer).
    // No patched release: 4.0.7 is the latest picomatch. audit-ci reports each path as a head-anchored
    // "a>b>picomatch" string whose head and trailing ">" vary run to run (npm audit key order), so a
    // verbatim per-path list is flaky. Instead there is one entry per package in picomatch's dev-only
    // transitive effects set (all "dev": true in the lockfile), each as "<full package name>>*": a path
    // must START at one of these packages. Paths carry no dev/prod marker, so a listed package that became
    // a PRODUCTION dependency would still match: the CI "Production-only npm audit" steps (HEL-1753, no
    // allowlist) are the guard for that case. Do NOT loosen to "picomatch*", "jest*" or a leading "*".
    // Re-derive the set from `npm audit --json` if the lockfile changes.
    // Review-by 2026-12-17; remove once picomatch > 4.0.7 ships.
    "GHSA-fc5q-39xc-vjpf|@jest/console>*",
    "GHSA-fc5q-39xc-vjpf|@jest/core>*",
    "GHSA-fc5q-39xc-vjpf|@jest/environment>*",
    "GHSA-fc5q-39xc-vjpf|@jest/environment-jsdom-abstract>*",
    "GHSA-fc5q-39xc-vjpf|@jest/expect>*",
    "GHSA-fc5q-39xc-vjpf|@jest/fake-timers>*",
    "GHSA-fc5q-39xc-vjpf|@jest/globals>*",
    "GHSA-fc5q-39xc-vjpf|@jest/reporters>*",
    "GHSA-fc5q-39xc-vjpf|@jest/test-result>*",
    "GHSA-fc5q-39xc-vjpf|@jest/test-sequencer>*",
    "GHSA-fc5q-39xc-vjpf|@jest/transform>*",
    "GHSA-fc5q-39xc-vjpf|@rollup/plugin-babel>*",
    "GHSA-fc5q-39xc-vjpf|@rollup/plugin-node-resolve>*",
